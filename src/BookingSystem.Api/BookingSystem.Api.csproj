<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dfbe389b-7316-4845-b2dd-7887f08e42f6</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Azure.SignalR" Version="1.29.0" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BookingSystem.Application\BookingSystem.Application.csproj" />
    <ProjectReference Include="..\BookingSystem.Infrastructure\BookingSystem.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <AngularWebProjectDir>$(MSBuildProjectDirectory)\..\BookingSystem.Web</AngularWebProjectDir>
    <AngularBuildOutputDir>$(AngularWebProjectDir)\dist\BookingSystem.Web\browser</AngularBuildOutputDir>
  </PropertyGroup>

  <Target Name="BuildAngularApp" BeforeTargets="ComputeFilesToPublish" Condition="'$(Configuration)' == 'Release'">
    <Message Importance="high" Text="Building Angular app in $(AngularWebProjectDir)..." />
    <Exec Command="npm ci" WorkingDirectory="$(AngularWebProjectDir)" Condition="!Exists('$(AngularWebProjectDir)\node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(AngularWebProjectDir)" />
  </Target>

  <!-- Static web assets are normally discovered from wwwroot during Build, which already runs
       before ComputeFilesToPublish — so files only copied into wwwroot at this point would be
       missed by that mechanism. Adding them directly to ResolvedFileToPublish here (right after
       ComputeFilesToPublish, still before Publish's own copy step) guarantees they land in the
       publish output regardless of that timing. -->
  <Target Name="AddAngularAppToPublish" AfterTargets="ComputeFilesToPublish;BuildAngularApp" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <AngularDistFiles Include="$(AngularBuildOutputDir)\**" />
    </ItemGroup>
    <Error Condition="!Exists('$(AngularBuildOutputDir)')" Text="Angular build output not found at $(AngularBuildOutputDir). Did the Angular build fail?" />
    <RemoveDir Directories="$(MSBuildProjectDirectory)\wwwroot" Condition="Exists('$(MSBuildProjectDirectory)\wwwroot')" />
    <Copy SourceFiles="@(AngularDistFiles)" DestinationFolder="$(MSBuildProjectDirectory)\wwwroot\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <ItemGroup>
      <ResolvedFileToPublish Include="@(AngularDistFiles)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
